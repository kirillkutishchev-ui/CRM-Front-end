ESPOCRM_VERSION=10.0.10

# Keep application ports private. Publish HTTPS only through a reverse proxy.
CRM_BIND_ADDRESS=127.0.0.1
CRM_HTTP_PORT=8080
CRM_WEBSOCKET_PORT=8081
CRM_SITE_URL=https://wesperr.studio
CRM_WEBSOCKET_URL=wss://wesperr.studio/ws
CRM_LANGUAGE=ru_RU
CRM_TIME_ZONE=Europe/Moscow
CRM_DEFAULT_CURRENCY=USD

CRM_ADMIN_HOSTS=wesperr.studio
CRM_ADMIN_ALLOWED_IPS=CHANGE_ME_TO_YOUR_FIXED_PUBLIC_IP

# Safe only when the proxy is the sole client allowed to reach the CRM port
# and overwrites X-Real-IP itself.
CRM_IP_ADDRESS_SERVER_PARAM=HTTP_X_REAL_IP

CRM_AUTH_TOKEN_LIFETIME=24
CRM_AUTH_TOKEN_MAX_IDLE_TIME=8
CRM_PASSWORD_MIN_LENGTH=10
CRM_PASSWORD_MIN_LETTERS=1
CRM_PASSWORD_MIN_NUMBERS=1
CRM_PASSWORD_BOTH_CASES=true
CRM_ADMIN_PASSWORD_RECOVERY_DISABLED=true
CRM_ADMIN_UPGRADE_DISABLED=true

CRM_ADMIN_USERNAME=admin
CRM_ADMIN_PASSWORD=GENERATE_A_LONG_RANDOM_SECRET

MARIADB_DATABASE=espocrm
MARIADB_USER=espocrm
MARIADB_PASSWORD=GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET
MARIADB_ROOT_PASSWORD=GENERATE_ANOTHER_LONG_RANDOM_SECRET

MQ_ENABLED=true
MQ_HOST=crm_rabbitmq
MQ_PORT=5672
MQ_USER=crm
MQ_PASSWORD=GENERATE_A_FOURTH_LONG_RANDOM_SECRET
MQ_VHOST=/
MQ_EXCHANGE=crm.events
MQ_DLX=crm.dlx
MQ_PREFETCH=1
MQ_MAX_ATTEMPTS=3
MQ_RETRY_DELAY_MS=5000
MQ_TASK_RETENTION_DAYS=7
MQ_TASK_TIMEOUT_SECONDS=120
# Optional HTTPS management container; actual client IP, never X-Forwarded-For.
MQ_MANAGEMENT_ALLOWED_IPS=158.160.144.108/32
MQ_HTTPS_BIND_ADDRESS=127.0.0.1
MQ_HTTPS_PORT=15674
# For direct external access set MQ_HTTPS_BIND_ADDRESS=0.0.0.0 and provide a valid certificate.
# MQ_TLS_CERT_FILE=/etc/letsencrypt/live/mq.example.com/fullchain.pem
# MQ_TLS_KEY_FILE=/etc/letsencrypt/live/mq.example.com/privkey.pem

# Never publish AMQP port 5672. If the management console is needed remotely,
# keep this on loopback and expose it through HTTPS with an IP allow-list.
MQ_MANAGEMENT_BIND_ADDRESS=127.0.0.1
MQ_MANAGEMENT_PORT=15672
